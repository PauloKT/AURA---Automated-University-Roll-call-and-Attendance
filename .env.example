# Gere uma chave com o Python da .venv e django.core.management.utils.get_random_secret_key.
SECRET_KEY=change-me-please-use-django-utils-get_random_secret_key

# Servidor de desenvolvimento local, acessado pelo Cloudflare Tunnel.
DEBUG=True

# Acrescente o hostname retornado pelo Cloudflare Tunnel (sem https://).
ALLOWED_HOSTS=127.0.0.1,localhost
# Preencha com a origem HTTPS do túnel antes de acessar o sistema.
# Exemplo: CSRF_TRUSTED_ORIGINS=https://seu-hostname.trycloudflare.com
CSRF_TRUSTED_ORIGINS=
# O fluxo do projeto usa sempre HTTPS pelo Cloudflare; mantenha ambas como True.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Origens CORS permitidas (separadas por vírgula).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
